#!/usr/bin/env bash

set -euo pipefail

readonly GREEN='\033[0;32m'
readonly RED='\033[0;31m'
readonly NC='\033[0m'

log() {
  echo -e "${GREEN}$1${NC}"
}

die() {
  echo -e "${RED}Error: $1${NC}" >&2
  exit 1
}

cmd_check() {
  command -v "$1" &>/dev/null || die "'$1' is required but not found in PATH."
}

list_boxes() {
  podman ps -a --filter label=manager=distrobox --format '{{.Names}}' 2>/dev/null ||
    distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/ /, "", $2); print $2}'
}

box_exists() {
  local boxes
  boxes=$(list_boxes) || die "Unable to list boxes."
  grep -Fx -- "$1" <<<"$boxes" >/dev/null
}

pick_box() {
  local boxes
  boxes=$(list_boxes) || die "Unable to list boxes."
  [[ -n "$boxes" ]] || die "No boxes found. Create one with: box create <name>"

  local choice
  if command -v fzf &>/dev/null; then
    choice=$(printf '%s\n' "$boxes" | fzf --height=20% --prompt="box> " --exit-0) || exit 0
  else
    printf '%s\n' "$boxes" >&2
    read -r -p "Select box: " choice || return 0
  fi
  choice=$(echo "$choice" | tr -d '\r\n')
  echo "$choice"
}

inside_install() {
  [[ $(id -u) -eq 0 ]] || die "--inside must run as root inside a box"
  command -v host-spawn &>/dev/null || die "host-spawn not found in box (distrobox >= 1.7 provides it)"
  local spawn_help
  spawn_help=$(host-spawn --help 2>&1) || die "Unable to inspect host-spawn options."
  [[ "$spawn_help" == *-cwd* ]] || die "host-spawn too old: missing -cwd flag"

  local dest="/usr/local/bin/xdg-open" temporary
  mkdir -p /usr/local/bin
  temporary=$(mktemp /usr/local/bin/.xdg-open.XXXXXX)
  # Capture the path now: this local may be out of scope when EXIT runs.
  # shellcheck disable=SC2064
  trap "rm -f -- '$temporary'" EXIT
  cat >"$temporary" <<'EOF'
#!/bin/sh
# Shared paths already match the host; strip only the host mount prefix.
case "$PWD" in
  /run/host) cwd=/ ;;
  /run/host/*) cwd=${PWD#/run/host} ;;
  *) cwd=$PWD ;;
esac
exec host-spawn --no-pty -cwd "$cwd" xdg-open "$@"
EOF
  chmod 755 "$temporary"
  mv -f -- "$temporary" "$dest"
  trap - EXIT
  log "Installed xdg-open host bridge in $dest."
}

help() {
  cat <<EOF
Usage: box-fix-xdg-open [name]

Installs an xdg-open wrapper in a box that forwards URLs/files to the host
browser. Selects a box interactively when no name is given.
Requires sudo and host-spawn inside the box.
EOF
}

main() {
  if [[ "${1:-}" == "--inside" ]]; then
    shift
    inside_install
    return
  fi

  case "${1:-}" in
  help | -h | --help)
    help
    return
    ;;
  esac

  [[ $# -le 1 ]] || die "Usage: box-fix-xdg-open [name]"
  [[ -z "${container:-}" ]] && [[ ! -d /run/host ]] || die "run this on the host, not inside a box"
  cmd_check distrobox

  local name="${1:-}"
  if [[ -z "$name" ]]; then
    name=$(pick_box) || exit 1
    [[ -n "$name" ]] || exit 0
  fi
  [[ "$name" != -* ]] || die "Invalid box name: $name"
  box_exists "$name" || die "Box '$name' does not exist. Run: box list"

  local script
  script=$(readlink -f "$0")
  log "Fixing xdg-open in box '$name'..."
  # Stream the script because separate box homes may hide its host path.
  exec distrobox enter "$name" -- sudo bash -s -- --inside <"$script"
}

main "$@"
